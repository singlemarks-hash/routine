// Firestore 보안 규칙 — Firebase 콘솔에 붙여넣는 정본.
//
// 콘솔에서만 관리하면 앱 코드가 새 경로를 쓰기 시작해도 규칙이 따라가지 않는다.
// 실제로 그룹 점수 표식(members/{uid}/scored)이 그렇게 막혀 점수가 통째로 들어가지
// 않았다. 경로를 추가할 때는 반드시 이 파일과 콘솔을 함께 고친다.
//
// 주의: Firestore 규칙은 아래로 상속되지 않는다. match /members/{memberID} 는
// 그 문서만 덮고 하위 컬렉션은 덮지 않는다. 하위까지 열려면 {document=**} 가 필요하다.

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 로그인한 본인만 자기 문서를 읽고 쓸 수 있다
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
      match /{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }

    // 그룹 챌린지 — 로그인한 사용자는 방을 만들고 참여할 수 있다 (v1 신뢰 기반)
    match /groups/{roomID} {
      allow read, create, update, delete: if request.auth != null;
      match /members/{memberID} {
        allow read, write: if request.auth != null;
        // 점수 표식 — 한 발생에 상벌점이 한 번만 들어가게 하는 도장.
        // 이 줄이 없으면 점수 트랜잭션이 통째로 거부되어 랭킹이 0에서 멈춘다.
        match /scored/{markID} {
          allow read, write: if request.auth != null;
        }
      }
    }
  }
}

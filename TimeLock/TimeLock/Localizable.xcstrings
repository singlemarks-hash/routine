  "strings": {
    "Photo library access is off — allow it in iPhone Settings › AngryMoti.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사진 추가 권한이 꺼져 있습니다 — iPhone 설정 › 앵그리모티에서 허용하세요."
          }
        }
      }
    },
    "Couldn't prepare the video. Please try again.": {
      "extractionState": "manual",
      "localizations": {

      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "게스트 모드"
          }
        }
      }
    },
    "Guest records are stored only on this device, separate from any account. Create an account and future records will be saved there, surviving a device change.": {

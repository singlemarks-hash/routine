    "Safety Stop": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "안전 종료"
          }
        }
      },
      "comment": "배터리/저장공간/크래시/통화 불능 등 기기 사정으로 인한 무효 종료"
    },

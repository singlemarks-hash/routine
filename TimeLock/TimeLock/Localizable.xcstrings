    "Sign Up": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "회원가입"
          }
        }
      }
    },
    "All video recordings are stored only on this device.\nBy continuing, you agree to the Terms of Use and Privacy Policy.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 영상 기록은 이 기기에만 저장됩니다.\n계속하면 이용약관과 개인정보처리방침에 동의하는 것으로 간주합니다."
          }
        }
      }
    },
    "Record your focus with timelapse\nfor even stronger accountability": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "타임랩스로 나의 몰입을 기록해요\n더 강력하게"
          }
        }
      }
    },
    "Tap a button below\nto log in or sign up.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {

          }
        }
      }
    },
    "AngryMoti is being built by Team Singlemark": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앵그리모티는 작은따옴표팀이 만들고 있습니다"
          }
        }
      }
    },
    "We dream of a world where everyone can finally say ‘I did it’ to that one bucket-list goal they carry in their heart. Until that meaningful goal becomes real, AngryMoti will keep building what it takes to get you there.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "누구나 마음속에 품고 있던 그 버킷리스트 목표에 ‘해냈다’고 말할 수 있는 세상을 꿈꿉니다. 그 소중한 목표가 현실이 될 때까지, 앵그리모티는 필요한 것을 계속 만들어가겠습니다."
          }
        }
      }
    },
    "Rate & Review on the App Store": {
      "extractionState": "manual",
      "localizations": {

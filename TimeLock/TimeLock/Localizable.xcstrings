          }
        }
      }
    },
    "Your activity slots are full (%ld/%ld). Groups take up a slot too — clear an existing activity or build a streak to unlock more slots.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "활동 슬롯이 가득 찼어요 (%ld/%ld). 그룹도 슬롯 1개를 차지해요 — 기존 활동을 정리하거나 연속 달성으로 슬롯을 늘려주세요."
          }
        }
      }
    },
    "A group room you joined was cleaned up after its results retention period ended.": {

<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-feature android:name="android.hardware.camera.front" android:required="true" />

    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 예약 시각 정밀 알람 — 알람 앱의 본질 기능 (Play 정책상 사용 사유 명확) -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <!-- 배터리 최적화 예외 요청 — OEM 절전(삼성 '미사용 앱 절전' 등)에 걸리면 정시 알람이
         아예 오지 않는다. 정시 알람이 본질 기능인 알람 앱은 Play 정책상 허용 사유에 해당한다.
         강제하지 않고 마이페이지 '알람 점검'에서 사용자가 직접 켜도록만 안내한다. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CAMERA" />
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:name=".AngryMotiApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:supportsRtl="false"
        android:theme="@style/Theme.AngryMoti">

        <!--
          대형 화면(sw600dp+)에서도 방향 잠금을 유지한다.
          targetSdk 36부터 태블릿·폴더블에서는 screenOrientation과 setRequestedOrientation()이
          무시되는데, 이 앱은 거치 가이드에서 사용자가 세로/가로를 고르고 그 방향으로 잠근 뒤
          촬영을 시작한다. 촬영 도중 화면이 회전하면 타임랩스 프레임의 방향이 중간에 바뀌어
          결과물이 깨진다 — 단순 레이아웃 문제가 아니라 산출물이 망가지는 문제라 잠금을 유지한다.
          이 opt-out은 targetSdk 37부터는 통하지 않으므로, 그 전에 '녹화 중 회전 대응'을
          제대로 만들어야 한다 (거치 가이드 화면은 이미 세로·가로 레이아웃을 모두 갖고 있다).
        -->
        <property
            android:name="android.window.PROPERTY_COMPAT_ALLOW_RESTRICTED_RESIZABILITY"
            android:value="true" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden"
            android:theme="@style/Theme.AngryMoti">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 예약 알람 수신 → 풀스크린 알람 표시 -->
        <receiver android:name=".services.AlarmReceiver" android:exported="false" />
        <!-- 재부팅 후 알람 재등록 -->
        <receiver android:name=".services.BootReceiver" android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- 촬영 세션 유지용 포그라운드 서비스 (OEM 백그라운드 킬 방어) -->
        <service
            android:name=".services.SessionService"
            android:exported="false"
            android:foregroundServiceType="camera" />
    </application>
</manifest>
